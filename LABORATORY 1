import java.util.Scanner;

public class Canteen {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // Canteen Menu
        String[] items = {
            "Burger",
            "Pizza",
            "Pasta",
            "Sandwich",
            "Milk Tea"
        };

        double[] prices = {
            80.00,
            120.00,
            100.00,
            70.00,
            90.00
        };

        // Transaction totals
        int totalQuantity = 0;
        double totalBeforeDiscount = 0.00;
        double totalDiscount = 0.00;

        char orderAgain = 'Y';

        // Continue ordering while the customer chooses Y
        while (orderAgain == 'Y') {

            // Display menu
            System.out.println("\n===== M E N U =====");

            for (int i = 0; i < items.length; i++) {
                System.out.printf("%d. %-10s - $%.2f%n",
                        i + 1, items[i], prices[i]);
            }

            // Get item number
            System.out.print("\nEnter item number: ");
            int itemNumber = input.nextInt();

            // Get quantity
            System.out.print("Enter quantity: ");
            int quantity = input.nextInt();

            // Get student status
            System.out.print("Are you a student? (Y/N): ");
            char student = input.next().toUpperCase().charAt(0);

            // Validate the order
            if (itemNumber < 1 || itemNumber > items.length ||
                quantity < 1 || quantity > 10 ||
                (student != 'Y' && student != 'N')) {

                System.out.println(
                    "\nInvalid order! Please enter a valid item and quantity."
                );

                // Skip this invalid order
                continue;
            }

            // Calculate subtotal
            double subtotal = prices[itemNumber - 1] * quantity;

            // Determine discount
            double discountRate;

            if (student == 'Y' && subtotal >= 500) {

                // Student + $500 or more = 15%
                discountRate = 0.15;

            } else if (student == 'Y') {

                // Student = 10%
                discountRate = 0.10;

            } else if (subtotal >= 500) {

                // Non-student + $500 or more = 5%
                discountRate = 0.05;

            } else {

                // No discount
                discountRate = 0.00;
            }

            // Calculate discount amount
            double discount = subtotal * discountRate;

            // Calculate final order total
            double orderTotal = subtotal - discount;

            // Display order computation
            System.out.printf("\nSubtotal: $%.2f%n", subtotal);
            System.out.printf("Discount: $%.2f%n", discount);
            System.out.printf("Order total: $%.2f%n", orderTotal);

            // Add valid order to transaction totals
            totalQuantity += quantity;
            totalBeforeDiscount += subtotal;
            totalDiscount += discount;

            // Ask if customer wants another order
            System.out.print(
                "\nDo you want to order again? (Y/N): "
            );

            orderAgain = input.next().toUpperCase().charAt(0);

            // Only Y continues the ordering process
            if (orderAgain != 'Y') {
                orderAgain = 'N';
            }
        }

        // Final computation
        double finalAmount = totalBeforeDiscount - totalDiscount;

        // Display order summary
        System.out.println("\n===== ORDER SUMMARY =====");

        System.out.println("Total items: " + totalQuantity);

        System.out.printf(
            "Total before discount: $%.2f%n",
            totalBeforeDiscount
        );

        System.out.printf(
            "Total discount: $%.2f%n",
            totalDiscount
        );

        System.out.printf(
            "Final amount: $%.2f%n",
            finalAmount
        );

        System.out.println("Thank you for ordering!");

        input.close();
    }
}